      private function onDuplicateDirectory():void {
        isDuplicating = true; 	
        onProcess();
      }
      
      private function duplicateFiles():void {
        var file:File = new File();
        file.addEventListener(Event.SELECT, duplicateFilesProcessPsuedoThread);
        file.browseForDirectory("Select empty destination directory");
        processing.visible = true;
      }

      private var excludeFiles:Array = [
        '$RECYCLE.BIN',
        'System Volume Information',
        '.git',
        '.svn',
        '.DS_Store',
        '.Trashes',
        '.Trash'
      ];
  
      private var duplicationPsuedoThread:PseudoThread;

      private var reSource:RegExp;
      
      private function duplicateFilesProcessPsuedoThread(e:Event):void {

        var target:File = e.target as File;
        if(target.nativePath == (tree.selectedItem as File).nativePath) {
          duplicationFiles.removeAll();
          Alert.show("You cannot copy the test files to the same location! You should preferably select or create an empty folder.");
          return;
        }
        
        reSource = new RegExp("^" + (tree.selectedItem as File).nativePath.replace(/\\/g,"\\\\") + "(.*)");

        duplicationPsuedoThread = new PseudoThread(systemManager, duplicateFilesProcess, {files: duplicationFiles, target: target});
        duplicationPsuedoThread.addEventListener("threadComplete", duplicationPsuedoThreadComplete);
      }
      
      private function duplicationPsuedoThreadComplete(e:Event):void {
        duplicationFiles.removeAll();
        processing.visible = false;
      }
      
      
      private function duplicateFilesProcess(obj:Object):Boolean {

        processing_label.text = 'Duplicating Files/Structure...' + (obj.files as ArrayCollection).length + ' files remaining.';

        if((obj.files as ArrayCollection) == null || (obj.files as ArrayCollection).length < 1)
          return false;
        
        var f:File = (obj.files as ArrayCollection).removeItemAt(0) as File;
        if(excludeFiles.indexOf(f.name) > -1)
          return true;
        
        if(cancelProcessing) {
          cancelProcessing = false;
          processing.visible = false;
          Alert.show("Duplication cancelled! Some files may have already been created in the destination folder.");
          return false;
        }
        
        var match:Array = reSource.exec(f.nativePath);
        if(match) {
          var dest:String = obj.target.nativePath + match[1];
          var ff:File = f.resolvePath(dest);
          if(ff.exists)
            return true;
          if(f.isDirectory) {
            ff.createDirectory();
          } else if(f.isSymbolicLink) {
            // do nothing? Not sure what would happen so just ignore for now
          } else {
            if(f.size < config.smallFileCopyLimit * 1024) {
              f.copyTo(ff);
            } else {
              var fileStream:FileStream = new FileStream();
              fileStream.open(ff, FileMode.WRITE);
              fileStream.close();	    
            }
          }
        } else {
          trace("Couldn't match the native path of the source for replacement!");
        }
        
        return true;
      }

      private function onDragIn(e:NativeDragEvent):void
      {
        if(e.clipboard.hasFormat(ClipboardFormats.FILE_LIST_FORMAT))
        {
          DragManager.acceptDragDrop(this);
        }
      }
      
      private function onDragDrop(e:NativeDragEvent):void
      {
        var files:Array = e.clipboard.getData(ClipboardFormats.FILE_LIST_FORMAT) as Array;
        
        resetFiles();
        isDuplicating = false;
        dirState = 'all';
        nfos.removeAll();

        var tempParentsNativePaths:Array = [];
        dirFolders = [];
        for each(var file:File in files) {
          dragDroppedFiles.push(file.nativePath);
          if(tempParentsNativePaths.indexOf(file.parent.nativePath) == -1) {
            tempParentsNativePaths.push(file.parent.nativePath);
            dirFolders.push({item: file.parent, sub:false});
          }
        }
        readDirs();
      }

      private function resetFiles():void {
        files = new ArrayCollection;
        files.filterFunction = onFilterFiles;
        
        var sort:Sort = new Sort();
        sort.fields = [ new SortField('name', true)] ;	
        files.sort = sort;

        dragDroppedFiles = [];
      }
      
      
    ]]>
  </mx:Script>
  
  <mx:ArrayCollection id="files" filterFunction="onFilterFiles"/>
  <mx:ArrayCollection id="duplicationFiles"/>
  <mx:ArrayCollection id="nfos"/>
  <mx:ArrayCollection id="undos" source="{config.undoList}"/> 
  
  <mx:ViewStack id="stack" width="100%" height="100%" creationPolicy="all" fontThickness="120"
                paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10">
    <mx:Canvas id="folder_select" width="100%" height="100%">
      <mx:VBox width="100%" height="100%" verticalGap="3">
        <mx:HBox width="100%">
          <mx:Button id="process_btn" label="List Movies from Selected Folder" click="onProcess();"
                     styleName="btn"/>
          <mx:Spacer width="15"/>
          <mx:ComboBox id="recent_folders" visible="{config.recentlyUsedFolders.length &gt; 0}"
                       change="onRecentlyUsedFolderSelected()"
                       dataProvider="{config.recentlyUsedFolders}" prompt="Recently Used Folders"/>
          <mx:Button id="refresh_btn" label="Refresh" click="onRefresh();" styleName="btn"/>
          <mx:Spacer width="100%"/>
          <mx:Label id="ver" buttonMode="true"
                    click="navigateToURL(new URLRequest('http://sourceforge.net/projects/zeeb/files/'))"
                    color="#999999" fontSize="10" mouseChildren="false" paddingTop="5"
                    toolTip="Click to go to the Zeeb SourceForge page" useHandCursor="true"/>
          <mx:Label id="notes" buttonMode="true" click="showReleaseNotes()" color="#999999"
                    fontSize="10" mouseChildren="false" paddingTop="5" text="notes"
                    toolTip="Click to show the release notes" useHandCursor="true"/>
          <mx:Button id="options_btn" label="Options" click="onOptions()" styleName="btn"/>
          <mx:Button id="check_update" label="Check for Updates" click="checkForUpdate(true)"
                     styleName="btn"/>
          <mx:Spacer width="15"/>
        </mx:HBox>
        <mx:VBox width="100%" height="100%" borderStyle="solid" borderThickness="3" cornerRadius="3"
                 paddingBottom="10" paddingRight="15" paddingTop="10">
          <file1:FastDirectorySystemTree id="tree" width="100%" height="100%" backgroundAlpha="0.3"
                                         backgroundImage="@Embed('/assets/icon/zeeb512.png')"
                                         borderStyle="none"
                                         directoryChange="reading.data = valueCommitsBeforeDirLoaded;"
                                         enumerationMode="directoriesOnly" fontSize="14"
                                         paddingBottom="0" paddingTop="0" rollOverColor="0xcccccc"
                                         selectionColor="0xbbbbbb"
                                         showHidden="{config.showHiddenFiles}" showRoot="true"
                                         valueCommit="reading.data = int(reading.data) - 1;"/>
        </mx:VBox>
        <mx:HBox>
          <mx:Label paddingTop="5" text="Directory Search Style:"/>
          <mx:RadioButtonGroup id="recursion_type"
                               change="config.recurseForMovies = String(recursion_type.selectedValue);"
                               selectedValue="{config.recurseForMovies}"/>
          <mx:RadioButton label="only" groupName="recursion_type" paddingTop="4"
                          toolTip="Only look in this directory, not in subfolders."/>
          <mx:RadioButton label="subfolders" groupName="recursion_type" paddingTop="4"
                          toolTip="Look in folders of this directory, but not in subfolders inside each folder."/>
          <mx:RadioButton label="full subfolders" groupName="recursion_type" paddingTop="4"
                          toolTip="Look in folders of this directory, and in subfolders inside each folder."/>
          <mx:Button label="Duplicate for Testing" click="onDuplicateDirectory()" styleName="btn"
                     toolTip="Make a copy of the selected folder's contents to a destination you specify, so that you can test that your customized naming formats work as expected before renaming the original files. Files over {config.smallFileCopyLimit} Kilobytes will be zero sized in the test directory, which allows NFO and other processing to work as expected without having to copy huge media files."/> 
        </mx:HBox>
        <mx:Text fontSize="12" paddingTop="-8"
                 text="(Note: Opening folders and listing movies can take several seconds or more, especially on network shares or WiFi or when listing movies in subfolders.)"/>
      </mx:VBox>
      <mx:Canvas id="reading" visible="{reading.data &gt; 0}" backgroundColor="#444444"
                 horizontalCenter="0" includeInLayout="false" mouseEnabled="false"
                 verticalCenter="0">
        <mx:Label id="reading_label" color="#FFFFFF" paddingBottom="5" paddingLeft="5"
                  paddingRight="5" paddingTop="5" text="Reading Directory..."/>
      </mx:Canvas>
      <mx:Canvas id="processing" visible="false" backgroundColor="#444444" horizontalCenter="0"
                 horizontalScrollPolicy="off" includeInLayout="false" mouseEnabled="false"
                 verticalCenter="0" verticalScrollPolicy="off">
        <mx:HBox paddingBottom="20" paddingLeft="20" paddingRight="20" paddingTop="20">
          <mx:Label id="processing_label" color="#FFFFFF" paddingBottom="5" paddingLeft="5"
                    paddingRight="5" paddingTop="5" text="Reading Filenames...({files.length})"/>
          <mx:Button label="cancel" click="cancelProcessing = true;" paddingTop="5" styleName="btn"/>					
        </mx:HBox>
      </mx:Canvas>
    </mx:Canvas>
    
    <mx:Canvas id="process" width="100%" height="100%" horizontalScrollPolicy="off"
               verticalScrollPolicy="off">
      <local:Renamer id="renamer0" visible="false" data="{this}"/>
      <local:Renamer id="renamer1" visible="false" data="{this}"/>
    </mx:Canvas>
  </mx:ViewStack>
  
