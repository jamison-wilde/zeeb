      private function onPreInit():void {
        //				URLRequestDefaults.userAgent = "Zeeb AIR App";
        
        addEventListener(Event.CLOSING, onClose);
        
        config = new Config();
        config.load();
        
        // bug fix: remove next version or so
        switch(config.recurseForMovies) {
          case 'all':
            config.recurseForMovies = 'full subfolders';
            break;
          case 'single':
            config.recurseForMovies = 'subfolders';
          case 'none':
            config.recurseForMovies = 'only';
        }
      }
      
      private function onClose(event:Event):void
      {
        for each (var window:NativeWindow in nativeApplication.openedWindows)
        {
          window.close();
        }
      }
      
      private function onComp():void {
        var version:String = getApplicationVersion();			
        ver.text = version;
        
        if(!config.autoUpdateMessageShown) {
          Alert.show("A *fixed* Auto Updating feature is now available, to ease the effort required to keep Zeeb current. The next time Zeeb starts, and one a week thereafter, Zeeb will check for an update and offer you the option to download and install it if available. If you do not want to use this feature, please uncheck the option in the Options."); 
          config.autoUpdateMessageShown = true;
        } else if(config.checkForUpdates == true)
          checkForUpdate();
        
        if(version != config.releaseNotesShownForVersion) {
          config.releaseNotesShownForVersion = version;
          showReleaseNotes();
        }
        
        if(!config.logfileLocation || config.logfileLocation == '') {
          var logFile:File = File.applicationStorageDirectory;
          logFile = logFile.resolvePath('zeeb.log');
          config.logfileLocation = logFile.nativePath;
        }
        saveConfig();
        nativeWindow.addEventListener(Event.CLOSING, windowClosing);

        //register for the drag enter event
        addEventListener(NativeDragEvent.NATIVE_DRAG_ENTER, onDragIn);
        
        //register for the drag drop event
        addEventListener(NativeDragEvent.NATIVE_DRAG_DROP, onDragDrop);

      }
      
      private function showReleaseNotes():void {
        var r:ReleaseNotes = new ReleaseNotes();
        r.initialize();
        r.data = releaseMessage;
        PopUpManager.addPopUp(r, this, true);
      }
      
      
      private var oneTimeWindowComplete:Boolean = false;
      private function onWindowComp():void {
        if(!oneTimeWindowComplete) {
          // seeing a bunch of these calls...guessing maximize or something causes it.
          oneTimeWindowComplete = true;
          this.nativeWindow.height = config.height;
          this.nativeWindow.width = config.width;
          if(config.maximized) {
            this.nativeWindow.maximize();
          }
          
          if(config.lastFolder && config.lastFolder != "") {
            tree.openSubdirectory(config.lastFolder);
            tree.selectedPath = config.lastFolder;
          } else {
            reading.data = 0;					
          }
          
          activeRenamer = renamer0;
          activeRenamer.visible = true;
        }
      }
      
      public function windowClosing(e:Event):void {
        config.height = this.nativeWindow.height;
        config.width = this.nativeWindow.width;
        config.maximized = (this.nativeWindow.displayState == NativeWindowDisplayState.MAXIMIZED);
        
        saveConfig();
      }
      
      public function saveConfig():void {
        config.save();
        // if the logfile changed, make sure we update it
        renamer0.changeLogLocation();
        renamer1.changeLogLocation();
      }

      public function onRefresh():void {
        tree.refresh();
      }
      
      public function onProcess():void {
        recent_folders.selectedIndex = -1;
        if(tree.selectedIndex) {
          
          if(config.recentlyUsedFolders.indexOf(tree.selectedPath) > -1)
            config.recentlyUsedFolders.splice(config.recentlyUsedFolders.indexOf(tree.selectedPath), 1);
          config.recentlyUsedFolders.unshift(tree.selectedPath);
          config.recentlyUsedFolders.splice(12); // only keep last 12 folders
          
          // remove all is giving me some errors, probably because of all the binds...
          // files.removeAll();
          if(isDuplicating) {
            duplicationFiles = new ArrayCollection;
          } else {
            resetFiles();
          }
          
          
          dirState = 'all';
          nfos.removeAll();
          
          dirFolders = [{item: tree.selectedItem as File, sub: false}];
          readDirs();
          
        } else {
          Alert.show('Please select a folder that contains movies.');
          isDuplicating = false;
        }
      }
      
      private function onRecentlyUsedFolderSelected():void {
        if(recent_folders.selectedItem && recent_folders.selectedItem != '') {
          tree.addEventListener(FlexEvent.VALUE_COMMIT, onRecentFolderReady);
          tree.openSubdirectory(recent_folders.selectedItem as String);
          tree.selectedPath = recent_folders.selectedItem as String;
        }
      }
      
      private function onRecentFolderReady(e:Event):void {
        trace(tree.selectedPath);
        tree.removeEventListener(FlexEvent.VALUE_COMMIT, onRecentFolderReady);
        onProcess();
      }
      
      private function readDirs():void {
        processing.visible = true;
        processing_label.text = 'Processing Filenames...';

        if(!cancelProcessing && dirFolders.length > 0) {
          var obj:Object = dirFolders.shift(); 
          var dir:File = obj.item;
          currentDirIsSubfolder = obj.sub; // this is a bit ugly...would be nice if File had a 'data' field we could actually use.
          parentFolderFiles = (obj.hasOwnProperty('parentFiles') ? obj.parentFiles : null); 
          dir.getDirectoryListingAsync();
          dir.addEventListener( FileListEvent.DIRECTORY_LISTING, handleDirectoryListing );
          return;
        }
        if(!cancelProcessing && dirState == 'all' && config.nfoFolder && config.nfoFolder != '') {
          dirState = 'nfo';
          processing.visible = true;
          processing_label.text = 'Reading NFO Folder(s)...';
          
          var f:File = new File(config.nfoFolder);
          if(!f.exists || !f.isDirectory) {	
            Alert.show('The NFO Folder is set incorrectly. Please correct this in the options.');
          } else {
            dirFolders = [{item: f, sub: false}];
            readDirs();
            return;
          }
        } 
        
        processing.visible = false;
        if(cancelProcessing) {
          cancelProcessing = false;
          return;
        }
                
        if(isDuplicating) {
          isDuplicating = false;
          duplicateFiles();
          return;
        }

        files.refresh();

        config.lastFolder = tree.selectedPath;
        stack.selectedChild = process;
        renamer0.visible = true;
        renamer1.visible = false;
        if(config.autoSelectFirstMovie && files.length > 0)
          setTimeout(autoSelectFirstMovie, 200);
      }
      
      private function autoSelectFirstMovie():void {
        renamer0.autoSelectFirstMovie();
      }
      
      private function handleDirectoryListing( event:FileListEvent ):void
      {
        var poster:String = null;
        var url:String = null;
        var testFile:File;
        var item:File;
        var baseName:String;
        var jpg:String;
        var urlName:String;
        
        
        
        if(!cancelProcessing && !isDuplicating && config.detectDVDs && dirState == 'all') {
          // pre-check to see if this is a DVD folder. 
          for each ( item in event.files ) {
            if(cancelProcessing) 
              return;
            
            if(dragDroppedFiles.length > 0 && dragDroppedFiles.indexOf(item.nativePath) == -1 )
              continue;
            
            if(item.name.toUpperCase() == 'VIDEO_TS.IFO' || item.name.toUpperCase() == 'VIDEO_TS' || item.name.toUpperCase() == 'BDMV') {
              // current target is the real item we want now, and we assume that we should not continue parsing subfolders.
              item = event.currentTarget as File;
              
              if(hasTT(item)) {
                baseName = item.name;
                
                // Look for a poster inside the dvd folder								 
                if(config.downloadPosters == true) {
                  jpg = baseName + '.jpg';
                  for each ( testFile in event.files ) {
                    if(testFile.name == jpg) {
                      poster = testFile.nativePath;
                      break;
                    }
                  }
                  
                  if(!poster) {
                    // now check in the parent folder for a poster
                    for each ( testFile in parentFolderFiles ) {
                      if(testFile.name == jpg) {
                        poster = testFile.nativePath;
                        break;
                      }
                    }
                  }
                }
                
                if(config.createURLFile == true) {
                  urlName = baseName + '.url';
                  for each ( testFile in event.files ) {
                    if(testFile.name == urlName) {
                      url = testFile.nativePath;
                      break;
                    }
                  }
                  if(!url) {
                    // now check in the parent folder for a .url
                    for each ( testFile in parentFolderFiles ) {
                      if(testFile.name == urlName) {
                        url = testFile.nativePath;
                        break;
                      }
                    }
                  }
                }
              }
              
              
              // using object for performance...passing the File object in as data was super slow in the file list
              var o:ObjectProxy = new ObjectProxy({
                folder: true,
                name: item.name,
                nativePath: item.nativePath,
                poster: poster,
                url: url
              });
              hasTT(o);
              files.addItem(o);
              
              return readDirs();
            }
          }
        }
        
        for each ( item in event.files )
        {

          if(dragDroppedFiles.length > 0 && dragDroppedFiles.indexOf(item.nativePath) == -1 )
            continue;
          
          poster = null;
          url = null;
          
          if(!cancelProcessing && dirState == 'all') {
            if(isDuplicating || item.extension && config.movie_extensions.indexOf(item.extension.toLowerCase()) > -1) {
              if(filterTTRegExp.exec(item.name)) {
                baseName = item.name.substr(0, item.name.length - item.extension.length);
                // so we already have a listing of the files, lets look for the
                // poster and url if it is an already renamed (with tt######) file.
                if(config.downloadPosters == true) {
                  jpg = baseName + 'jpg';
                  for each ( testFile in event.files ) {
                    if(testFile.name == jpg) {
                      poster = testFile.nativePath;
                      break;
                    }
                  }
                }
                if(config.createURLFile == true) {
                  urlName = baseName + 'url';
                  for each ( testFile in event.files ) {
                    if(testFile.name == urlName) {
                      url = testFile.nativePath;
                      break;
                    }
                  }
                }
              }
              
              
              if(isDuplicating) {
                duplicationFiles.addItem(item);
              } else {
                var p:ObjectProxy = new ObjectProxy({
                  folder: false,
                  name: item.name,
                  nativePath: item.nativePath,
                  poster: poster,
                  url: url,
                  size: item.size
                });
                hasTT(p);
                hasSample(p);
                // using object for performance...passing the File object in as data was super slow in the file list
                files.addItem(p);
              }
            }
          }
          
          // load up any nfo files while we are here so we can search them later
          if(!cancelProcessing && !isDuplicating && item.extension && item.extension.toLowerCase() == "nfo") {
            nfos.addItem(new ObjectProxy({
              full: item.nativePath,
              file: item.name
            }));
          }
          
          if(!cancelProcessing && item.isDirectory) {
            if( 
              (dirState == 'all' && (config.recurseForMovies == 'full subfolders' || (config.recurseForMovies == 'subfolders' && !currentDirIsSubfolder))) 
              || 
              (dirState == 'nfo' && config.nfoFolderRecurse)
            ) {	
              dirFolders.push({item: item, sub: true, parentFiles: event.files});
            }
          }
        }
        readDirs();
      }			
      
      private function hasTT(s:Object):Boolean {
        if(!s.hasOwnProperty('tt')) {
          s.tt = filterTTRegExp.exec(s.name);
        }
        return s.tt;
      }

      private function hasSample(s:Object):Boolean {
        if(!s.hasOwnProperty('sample'))
          s.sample = filterSampleRegExp.exec(s.name);
        return s.sample;
      }

      // NOTE: _? in the match below is a personal hack I use when movies
      // have multiple files, like extras or episodes. I rename the files t_t#######
      // so that I can look for duplicate movies without having to check these
      private var filterTTRegExp:RegExp = new RegExp(/t\_?t\d\d\d\d+/); 
      private var filterSampleRegExp:RegExp = new RegExp(/sample/i); 
      public function onFilterFiles(item:Object):Boolean {
        if(config.showTTFile == false && hasTT(item)) {
          return false;
        }
        if(config.showSampleFile == false && hasSample(item)) {
          return false;
        }
        
        return true;
      }
      
      public function flipVisible():void {
        var nextRenamer:Renamer = process.getChildAt(0) as Renamer;
        var selectNext:Boolean = false;
        for each (var renamer:Renamer in process.getChildren()) {
          if(selectNext) {
            nextRenamer = renamer;
            selectNext = false;						
          }
          if(renamer == activeRenamer) {
            selectNext = true;
          }
          renamer.visible = false;
        }
        activeRenamer = nextRenamer;
        activeRenamer.visible = true;
      }
      
      public function updateFile(reload:Boolean, permanentChange:Boolean = false):void {
        if(permanentChange) // write on the preferences on a permanent change
          saveConfig();
        for each (var renamer:Renamer in process.getChildren()) {
          if(permanentChange || renamer == activeRenamer) 
            renamer.updateFile(reload);
        }
      }
      
      public function scrollToIndex(index:int):void {
        if(index < 0)
          index = 0;
        var vsp:int = -1;
        for each (var renamer:Renamer in process.getChildren()) {
          renamer.files_to_process.scrollToIndex(index);
          if(vsp == -1) {
            vsp = renamer.files_to_process.verticalScrollPosition;
          } else {
            // if they manually change the scroll position, then it won't sync even with scrolltoIndex...
            renamer.files_to_process.verticalScrollPosition = vsp;
          }
        }
      }
      
      private var currentUndo:Array;
      
      public function beginUndoTransaction():void {
        currentUndo = [];
      }
      
      // action looks like:
      // ['rename', new, orig]
      // ['delete', name]
      
      public function addUndoAction(action:Array):void {
        currentUndo.push(action);
      }
      
      public function commitUndoTransaction():void {
        if(currentUndo && currentUndo.length > 0) {
          if(config.undoList == null) {
            config.undoList = []; // Why is this happening? Is the config file bad?
          }
          config.undoList.unshift(currentUndo);
          // only reemeber the last XX renames
          if(config.undoList.length > config.maxUndos) {
            while(config.undoList.length > config.maxUndos) {
              config.undoList.pop();
            }
          }
        }
        currentUndo = [];
        undos.refresh();
      }
      
