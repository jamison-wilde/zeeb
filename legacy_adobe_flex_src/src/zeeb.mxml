      private var showUpdateResults:Boolean = false;
      private function checkForUpdate(showResults:Boolean = false):void {
        showUpdateResults = showResults;
        
        appUpdater= new ApplicationUpdaterUI();
        appUpdater.updateURL = "https://zeeb.sourceforge.io/update.xml"; // Server-side XML file describing update
        appUpdater.delay = 7;
        appUpdater.isCheckForUpdateVisible = false; // We won't ask permission to check for an update
        appUpdater.addEventListener(UpdateEvent.INITIALIZED, onUpdate); // Once initialized, run onUpdate
        appUpdater.addEventListener(ErrorEvent.ERROR, onError); // If something goes wrong, run onError
        appUpdater.addEventListener(StatusUpdateEvent.UPDATE_STATUS,onUpdateStatus);
        appUpdater.addEventListener(StatusUpdateErrorEvent.UPDATE_ERROR, onError);
        appUpdater.addEventListener(StatusFileUpdateEvent.FILE_UPDATE_STATUS, onError);
        appUpdater.addEventListener(StatusFileUpdateErrorEvent.FILE_UPDATE_ERROR, onError);
        appUpdater.initialize(); // Initialize the update framework
      }
      
      private function onError(event:Event):void {
        Alert.show(event.toString());
      }
      
      private function onUpdateStatus(event:StatusUpdateEvent):void {
        if (event.available) {
        } else {
          if(showUpdateResults) 
            Alert.show("No updates are available at this time","No Updates Available");
        }
      }
      
      private function onUpdate(event:UpdateEvent):void {
        appUpdater.checkNow(); // Go check for an update now
      }
      
