				seeMoreLoader = new URLLoader(new URLRequest(url));
				seeMoreLoader.addEventListener(Event.COMPLETE, onSeeMoreComplete);
				trace('AkaSeeMore Called: ' + url);
			}
			
			private function onSeeMoreComplete(e:Event):void {
				var html:String = (e.target as URLLoader).data.toString();
//				trace(html);
				
				var results:Array;
				
				results = reAkaMoreGroup.exec(html);
				if(results) {
					currentMovieInfo.aka = []
					
					var akaIndex:int = 0;
					var akas:String = results[0];
					do {
						results = reAkaMore.exec(akas.substring(akaIndex));
						if(results) {
							akaIndex += (results[0].length + results.index);
							currentMovieInfo.aka.push((htmlUnescape( StringUtil.trim(results[2]).replace(/\.\.\./g,'…') + " *" + StringUtil.trim(results[1]) + "*")));
							if(bTraceDetails) trace('AkaMore: ' + htmlUnescape(StringUtil.trim(results[1]) + " *" + StringUtil.trim(results[2]) + "*"));
						}
					} while(results);
					
					currentMovieAKAs.source = currentMovieInfo.aka;
					currentMovieAKAs.refresh();
					aka_name.open();
				}
			}

