      private function handlePoster():Boolean {
        if(config.downloadPosters && original_poster && !poster_loading && original_poster.content != null &&
          original_poster.content is Bitmap &&
          (original_poster.content as Bitmap).bitmapData.height > 0 &&
          (original_poster.content as Bitmap).bitmapData.width > 0) {	

          
          // Old JpegEncoder Library code...
          //asyncEncoder = new JPEGAsyncEncoder(90);
          // new Alchemy based JPegEncoder library code
          asyncEncoder = new AlchemyAsyncJpegEncoder(93, 50);

          asyncEncoder.addEventListener(JPEGAsyncCompleteEvent.JPEGASYNC_COMPLETE, onEncodeComplete);
          asyncEncoder.encode((original_poster.content as Bitmap).bitmapData );
          
          
          _zeeb.flipVisible(); 
          return true;
        }
        return false;
      }
      
			private function onEncodeComplete(e:JPEGAsyncCompleteEvent):void {
				var posterFile:File;

        if(fileIsDVDFolder) {
          posterFile = new File(_destFile.nativePath + 
            (config.posterInDVDFolder ? '/' : '/../') + 
            (config.separatePosterFormat ? parseFormat(config.renameFormatPoster, currentMovieInfo, 'jpg') : _destFile.name + '.jpg' ));
        } else {
          if(config.separatePosterFormat)
            posterFile = new File(_destFile.nativePath + '/../' + parseFormat(config.renameFormatPoster, currentMovieInfo, 'jpg'));
          else 
            posterFile = new File(_destFile.nativePath.substr(0, _destFile.nativePath.length - _destFile.extension.length) + 'jpg');
        }

				var wr:File = new File( posterFile.nativePath );
				var stream:FileStream = new FileStream();
        
				try {
					stream.open( wr , FileMode.WRITE);
					stream.writeBytes ( e.data, 0, e.data.length );
					stream.close();
					_zeeb.addUndoAction(['delete', posterFile.nativePath]);
					log += "\nCreate Poster: " + posterFile.name;
				} catch(a:Error) {
					Alert.show("There was an error writing the poster. Your disk may be full or some other issue has occurred. Please resolve and try again.\n" + a.message, "Error");
				}

        onSkip(true, false);
			}
      
			private function onSkip(deleteSelected:Boolean = false, flip:Boolean = true):void {

        if(deleteSelected) {
          try {
            if(!_bPosterOnly) {
              removeEmptyFolder((renameContainingFolder() ? selectedFile.resolvePath('..') : selectedFile));
            }
          } catch(a:Error) {
            Alert.show("Unable to remove empty folder\n" + a.message, "Error");
          }

          try {
            _zeeb.commitUndoTransaction();
          } catch(a:Error) {
            Alert.show("Unable to commit undo transaction\n" + a.message, "Error");
          }

          try {
            writeToLog(log);
          } catch(a:Error) {
            Alert.show("Unable to write to log\n" + a.message, "Error");
          }
        }
        

        // make this an event? 
				if(flip)
					_zeeb.flipVisible(); 

				var index:int = files_to_process.selectedIndex;

				if(_zeeb.files.length > 1 || (!deleteSelected && _zeeb.files.length ==1)) {
					if(files_to_process.selectedIndex < _zeeb.files.length - 2) {
						files_to_process.selectedIndex += 2;
					} else if(files_to_process.selectedIndex == _zeeb.files.length - 2) {
						files_to_process.selectedIndex = 0;
					} else {
						files_to_process.selectedIndex = 1;
					}
					_zeeb.scrollToIndex(files_to_process.selectedIndex - 1);
				} else {
					_zeeb.forceCleanUp();
				}
				
				if(deleteSelected) {
          try {
					  _zeeb.files.removeItemAt(index);
          } catch(e:Error) {
            Alert.show("Error removing file from list of files...\n" + e.message);            
          }
        }
					
				onFileSelected(null);
			}
			
