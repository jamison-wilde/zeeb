			private const escapes:Array = [
				[/\\/g, '\\'], [/\./g, '\\.'], [/\-/g, '\\-'], [/\[/g, '\\['], [/\]/g, '\\]'], [/\{/g, '\\{'],
				[/\}/g, '\\}'], [/\^/g, '\\^'], [/\#/g, '\\#'], [/\+/g, '\\+'], [/\'/g, '\\\''], [/\$/g, '\\$'],
				[/\&/g, '\\&']
			];
			
			private function generateEscapedFilename(str:String):String {
				var escapedFileName:String = str;
				for each (var escape:Array in escapes) {
					escapedFileName = escapedFileName.replace(escape[0],escape[1]); 
				} 
				return escapedFileName;
			}
			
			private function getNextSelectedItem(event:GenericEvent):void {
				if(event.data.files_to_process.selectedIndex + 1 < _zeeb.files.length) {
					files_to_process.selectedIndex = event.data.files_to_process.selectedIndex + 1;
				} else {
					if(_zeeb.files.length > 0) {
						files_to_process.selectedIndex = 0;
					} else {
						files_to_process.selectedIndex = -1;
					}
				}
			}
			
			private function findNFOFile(name:String):File {
				selectedNFOFile = null;
				var reNfo:BigRegExp = new BigRegExp(name + ".*nfo$","i");

				for each(var nfo:ObjectProxy in _zeeb.nfos) {
					if(reNfo.exec(nfo.file)) {
						selectedNFOFile = new File(nfo.full);
						break;
					}
				}
				return selectedNFOFile;
			}
			
			private var reNfoUrl:BigRegExp = new BigRegExp(/(http:\/\/[a-z]+\.imdb\.[a-z]+\/title\/tt[0-9]+|http:\/\/imdb\.[a-z]+\/title\/tt[0-9]+)/i);
			private function findImdbUrlFromNfo(name:String):String {
				var imdb:String = "";
			
				selectedNFOFile = findNFOFile(generateEscapedFilename(name));
				if(selectedNFOFile) {
					var r:Array = reNfoUrl.exec(readNFO(selectedNFOFile));
					if(r)
						imdb = r[1];
				}
				return imdb;
			}

			private function handlePart720or1080(re:BigRegExp, part:String, parts:Array, i:int, cleaned:String):Boolean {
				var match:Array = re.exec(part)
				if(match) {
					parts[i] = match[1];
					if(!fileIsDVDFolder) {
						var ext:String = parts.pop(); // preserve the placement of the extension so it gets skipped properly
						if(parts.indexOf(cleaned) == -1) {
							parts.push(cleaned);
						}
						parts.push(ext);
					} else {
						if(parts.indexOf(cleaned) == -1) {
							parts.push(cleaned);
						}
					}
				}
				return Boolean(match);
			}
			
			private var rePartYear:BigRegExp = new BigRegExp(/(\d\d\d\d)/);
			private var rePartTT:BigRegExp = new BigRegExp(/tt\d\d\d\d\d+/); // don't include the tt or rating in the search parts
			private var rePartRating:BigRegExp = new BigRegExp(/^\d\.?\d$/); // don't include the tt or rating in the search parts
			private var rePart720:BigRegExp = new BigRegExp(/(.+)720p*$/); // split out the dumbasses who attach the quality with no separator
			private var rePart1080:BigRegExp = new BigRegExp(/(.+)1080p*$/); // split out the dumbasses who attach the quality with no separator
			
			// update the parts of the filename, determining which parts are in the title
			private function onFileSelected(event:GenericEvent):void {
				cleanUp(true);
				
				// the other renamer got the call...we need to get the next selected item if possible
				if(event && event.data != this) {
					getNextSelectedItem(event);
				}
				
				if(files_to_process.selectedIndex == -1) {
					selectedFile = null; // hide the rename controls
 					return; // no file selected
				}
				
				try {
					selectedFile = new File(files_to_process.selectedItem.nativePath);
				} catch (e:Error) {
					// the file might have been deleted from the file system
					selectedFile = null; // hide the rename controls
 					return; // no file selected
				}
        
				fileIsDVDFolder = files_to_process.selectedItem.folder;
				
        var tt:Array = parseFileName(selectedFile);
        
				renamer.visible = true;
				
				if(tt && show_tt.selected && use_tt.selected) {
					doImdbSingle({tt: tt[0]});
					return;
				}
				if(!fileIsDVDFolder) {
					var sNFOLookup:String = findImdbUrlFromNfo(selectedFile.name.substr(0, selectedFile.name.length - (selectedFile.extension.length + 1)));
					if(sNFOLookup != "") {
						doImdbLookup(sNFOLookup);
						return;
					}
				}

				startLookupTimer(event && event.data == this ? 0 : 1000);
			}

      
      public function parseFileName(o:*):Array {
        var setRestOfPartsAsKeep:Boolean = false;
        var thisPartWasARealKeeper:Boolean = false;
        var tt:Array;
        
        var name:String;
        var file:File;
        
        if(o is String)
          name = o;
        else if(o is File) {
          file = o;
          if(config.includeFolderNameInSearchTerms && file && file.parent && file.parent.name)
            name = file.parent.name + " " + file.name;
          else
            name = file.name; 
        }
        
        var parts:Array = name.split(reFilenamePartsSplitter)
        
        movieYear = 0; // use movieYear for better match on remakes
        
        var extensionCount:int = 1;
        if(fileIsDVDFolder) 
          extensionCount = 0;
        
        for (var i:int = 0; i < parts.length - extensionCount ; i++) {
          var part:String = parts[i];
          var partLower:String = part.toLowerCase();
          
          // special handling for parts like 'avs720-somemovie', where we want to preserve the 720 for later
          if(handlePart720or1080(rePart720,part,parts,i,'720p') || handlePart720or1080(rePart1080,part,parts,i,'1080p')) {
            i--;
            continue;
          }
          
          thisPartWasARealKeeper = false;
          var state:String = "part";
          if(setRestOfPartsAsKeep)
            state = 'keep';
          
          // parse the filename for the dont search but keep shit
          // even if we are already auto keeping this part, check 
          // to make sure that we don't need to translate the part
          // like 720->720p, or DC-> Director's Cut

          for each (var keeper:Array in config.keepTerms) {
            if(keeper[0] == partLower) {
              state = 'keep';
              part = keeper[1];
              thisPartWasARealKeeper = true;
              if(assumeKeepPartsEndTitle) {
                setRestOfPartsAsKeep = true;
              }		
            }
          }					
          
          // don't do the remove or other logic if we have this marked as permanent keep
          // this assumes that you don't 'keep' tt##### for some dumb reason and then expect Use TT? to work
          if(!thisPartWasARealKeeper) {
            
            if(!reRemoveTerms) {
              reRemoveTerms = new RegExp('^' + config.removeTerms.join('$|^') + '$');
            }
            
            // parse the filename for all the bad shit
            if(reRemoveTerms.exec(partLower) != null) {
              state = 'remove';
            }
            
            var year:Array = rePartYear.exec(part)
            if(year && int(year[1]) > 1900) {
              state = 'remove';
              movieYear = year[1];
            }
            
            if(!tt) { // only look for the first tt#####
              tt = rePartTT.exec(part)
              if(tt) {
                state = 'remove';
              }
            }
            
            if(tt) {
              // we found a tt previously so lets see if this is a rating we need to remove
              // this assumes you are using something like the default format where
              // ratings follow the TT##### in the filename parts. Otherwise this code is a little
              // too overszealous.
              if(rePartRating.exec(part)) 
                state = 'remove';
            }
            
          }
          
          switch(state) {
            case 'keep':
              break;
            case 'remove':
              break;
            default:
              if (i > 0 && config.lowerTerms.indexOf(partLower) > -1) {
                part = partLower;
              }
          }	
          
          if(part != "") {
            var sp:SearchPart = new SearchPart;
            sp.initialize();
            sp.showImages = config.showPartIcons;
            sp.data = new ObjectProxy({
              state: state,
              part: part
            });
            search_parts.addChild(sp);					
          }
        }
        
        return tt;
        
      }
        
			private var searchUrl:String;

      // do an imdb search with the current 'parts'
			public function doImdbLookup(url:String = null):void {
//				orig_parts.text = "";
				if(url) {
					searchUrl = url; // if we have an exact tt# url from the nfo...
				} else {
					searchUrl = config.searchUrl;
	
					var firstPart:Boolean = false;
					for each(var sp:SearchPart in search_parts.getChildren()) {
						if(sp.data.state == 'part') {
							var part:String = sp.data.part;
							if(part == "&") {
								part = '%26';
							}
							if(!firstPart) {
								firstPart = true;
							} else {
								searchUrl += '%20';
							}
							searchUrl = searchUrl + part; 
						}
					}				
				}
				
				trace('########################\nSearch URL: ' + searchUrl + " : " + this.id);
				
				ul = new URLLoader();
				ul.addEventListener(Event.COMPLETE, onImdbLookupComplete);
				ul.addEventListener(IOErrorEvent.IO_ERROR, onIOError);
				try {
          loadURLLoader(ul, new URLRequest(searchUrl));
				} catch (e:Error) {
					onIOError(null);
					return;
				}
			}
			
			private function onIOError(e:IOErrorEvent):void {
					Alert.show("There was an error doing the IMDB search.  Please try the following URL manually and see what happens. Pass it along if it isn't a temporary IMDB error. " + searchUrl); 				
			}
	
	
			private var tempMovie:Object; // hack temp holder
			// do an imdb search with the current 'parts'
			public function doImdbSingle(movie:Object):void {
        posters_status.text = 'Waiting for IMDB lookup.';
        posters_status.visible = true;
        if(movie.tt) {
          tempMovie = movie;					
          var url:String = config.urlImdbTT + movie.tt;
          try {if (ul) ul.close();} catch(e:Error) {};
          ul = new URLLoader();
          ul.addEventListener(Event.COMPLETE, onImdbSingleComplete);
          loadURLLoader(ul, new URLRequest(url));
        }
			}
			
			public function setOriginalFilename():void {
				origFilename = "";
				for each(var sp:SearchPart in search_parts.getChildren()) {
					if(sp.data.state == 'part') {
						origFilename = origFilename + ' ' + sp.data.part; 
					}
				}				
			}

			// parse the imdb tt single movie results
			private function onImdbSingleComplete(e:Event):void {
				try {
					ul.removeEventListener(Event.COMPLETE, onImdbSingleComplete);
				} catch(e:Error) {};

        var html:String = (e.target as URLLoader).data.toString();
				var newMovies:ArrayCollection = new ArrayCollection; // prevent repeat updates when updating by swapping the array collections
				
				reMovie(newMovies, html, 'Exact');
				setMovieInfo(newMovies[0], bAKAUsed);
			}

			
			// parse the imdb search results for all the movies returned, and update the controls
			private function onImdbLookupComplete(e:Event):void {
				try {
					ul.removeEventListener(Event.COMPLETE, onImdbLookupComplete);
					ul.removeEventListener(IOErrorEvent.IO_ERROR, onIOError);
				} catch(e:Error) {};
				
				var re:BigRegExp;
        var html:String = (e.target as URLLoader).data.toString();
//				trace(html);

				movies = new ArrayCollection;
				var newMovies:ArrayCollection = new ArrayCollection; // prevent repeat updates when updating by swapping the array collections
				
				// get rid of the b.gif images...prob beed a better regexp to deal with them instead
				html = html.replace(/img src="\/images\/b.gif"/g,'');
 
        
        if(!reFindNoResults.exec(html)) {         
   				re = new BigRegExp(config.reTitle);
   				// check to see if we got an exact match and therefore no search results
   				if(re.exec(html) != null) {
            
  					reMovies(newMovies, html);
   					
   				} else {  
   					// single movie returned
   					reMovie(newMovies, html, 'Exact');
   				}
        }
				
				movies = newMovies;
				
				if(movies.length) {
					var index:int = 0;
					// see if we can find a year match on the movie in the first few movies
					if(movieYear && movieYear > 1900) {
						for (var i:int; i < movies.length && i < 8; i++) { 
							if(int(movies[i].year) == movieYear) {
								index = i;
								break;
							}
						}
					}
					
					movie_tiles.selectedIndex = index;
					doImdbSingle(movies[index]);
				} else {
          posters_status.text = 'No matches found on IMDB.';
          posters_status.visible = true;
        }
			}

			// We need to get the ratings when ever we update which movie we are using.
			private function updateMovie(movie:Object):void {
				doImdbSingle(movie);
			}
			
			// set the text for the final name of the movie			
			private function setMovieInfo(movie:Object, bUseAKA:Boolean = false):void {
				if(movie == null) {
					// this can occur if the first search returned nothing, and then the user edits the search parts manually and does save/keep/etc.
					return;
				}
				currentMovieInfo = movie;
				
				if(selectedFile && !movie.hasOwnProperty('title')) {
					Alert.show("For some reason we lost the current movie's info. This is a bug I am trying to fix. If you can reproduce, please let me know. Thanks.");
					return;
				}

				akaBox.visible = false;
				if(movie.aka && movie.aka.length > 0) {
					if(currentMovieAKAs.source != movie.aka) {
						currentMovieAKAs.source = movie.aka;
						currentMovieAKAs.refresh(); 
					}
					akaBox.visible = true;
				}
				
				// IMPORTANT: Move this below the AKA refresh for the original title handling to work properly
				if(bUseAKA) {
					bAKAUsed = true;
					generateFilename(((fileIsDVDFolder && config.separateDVDFolderFormat) ? config.renameAKAFormatDVDFolder : config.renameAKAFormat), movie);
				} else {
					bAKAUsed = false;
					generateFilename(((fileIsDVDFolder && config.separateDVDFolderFormat) ? config.renameFormatDVDFolder : config.renameFormat), movie);
				}
				
				if(movie.tt) {
					html_box.visible = true;
					if(currentMovieUrl != config.urlImdbTT + movie.tt) {
						trace('cancel HTML load on new location');
						html_box.htmlLoader.cancelLoad();
						html_box.htmlText = null;
						currentMovieUrl = config.urlImdbTT + movie.tt;
						trace('HTML: ' + currentMovieUrl );
						doTMDBLookup(movie.tt);
					}
				} else {
					trace('cancel HTML load on no location');
					html_box.htmlLoader.cancelLoad();
					currentMovieUrl = "";
					html_box.visible = false;
				}
				
				setOriginalFilename();
			}

      private function reverseName(name:String):String {
        try {
          var names:Array = name.split(" ");
          if(names && names.length) {
            return names[names.length - 1] + ", " + names.slice(0, names.length - 1).join(" ");
          }
        } catch(e:Error) {
          // maybe a single name? or something weird? Just return the original
        }
        return name;
      }
      
			
			public function parseFormat(format:String, movie:Object, ext:String = null):String {

        if(!movie.hasOwnProperty('rating')) {
          movie.rating = '0';
        }

				// THIS MUST BE FIRST BECAUSE OF SPECIAL AKA/TITLE MATCH HANDLING!!!!
				if((format.search('<a>') > -1 || format.search('<aka>') > -1) && movie.aka.length) {
					// get rid of any country helpers then clean up the title
					var aka:String;
          if(selectedFile) {
            aka = cleanTitle(aka_name.text.replace(/ \*.*\*/,''));

            var akaContainsTitle:Boolean = false;
            
            if(aka.toLowerCase().search(cleanTitle(movie.title).toLowerCase()) > -1) {
              akaContainsTitle = true;
            }
            
            if((config.removeThe || config.swapThe) && aka.substr(0,config.the.length + 1) == config.the + ' ') {
              aka = aka.substr(config.the.length + 1);
              if(config.swapThe)
                aka += ', ' + config.the;
            }
            
            if(config.replaceTitleSpacesWith && config.replaceTitleSpacesWith != '' && config.replaceTitleSpacesWith != ' ')
              aka = aka.replace(/\s/g, config.replaceTitleSpacesWith);
              
            if(akaContainsTitle) {	
              // Use the non-AKA format, and use the AKA instead of the title
              format = ((fileIsDVDFolder && config.separateDVDFolderFormat) ? config.renameFormatDVDFolder : config.renameFormat)
              format = format.replace(/<t>|<title>/g, aka);
            } else {
              format = format.replace(/<a>|<aka>/g, aka);
            }
            
          } else
            format = format.replace(/<a>|<aka>/g, movie.aka[0]);
				}
				
				var title:String = movie.title;
				if((config.removeThe || config.swapThe) && title.substr(0, config.the.length + 1) == (config.the + ' ')) {
          title = title.substr(config.the.length + 1);
          if(config.swapThe)
            title += ', ' + config.the;
        }
        
        if(config.replaceTitleSpacesWith && config.replaceTitleSpacesWith != '' && config.replaceTitleSpacesWith != ' ')
          title = title.replace(/\s/g, config.replaceTitleSpacesWith);
        
				format = format.replace(/<t>|<title>/g, title);

        
        var minutesDuration:int = parseInt(movie.duration);
        var hoursDuration:int = minutesDuration / 60;
        if (minutesDuration > 60) {
          minutesDuration %= 60;
        }
        
        while(true) {
          var matches:Array = format.match(/<H([^>]*)>/);
          if(matches) {
            var replacement:String = hoursDuration.toString() + matches[1];
            format = format.replace(/<H[^>]*>/, replacement);
          }
          else
            break;
        }
        
        while(true) {
          var matches2:Array = format.match(/<M([^>]*)>/);
          if(matches2) {
            var replacement2:String = minutesDuration.toString() + matches2[1];
            format = format.replace(/<M[^>]*>/, replacement2);
          }
          else
            break;
        }
        
        
				format = format.replace(/<y>|<year>/g, movie.year);
				format = format.replace(/<tt>|<imdb>/g, movie.tt);
				format = format.replace(/<r100>|<rating100>/g, movie.rating);
				format = format.replace(/<r10>|<rating10>/g, rating_formatter.format(Number(movie.rating) / 10));
				format = format.replace(/<d>|<directors>/g, movie.directors);
				format = format.replace(/<d1>|<director>/g, movie.director);
        format = format.replace(/<D>|<rdirectors>/g, movie.rev_directors);
        format = format.replace(/<D1>|<rdirector>/g, movie.rev_director);
				format = format.replace(/<g>|<genres>/g, movie.genres);
				format = format.replace(/<g1>|<genre>/g, movie.genre);
        format = format.replace(/<o>|<original>/g, (ext ? selectedFile.name.substr(0, selectedFile.name.length - 4)  : selectedFile.name));
        format = format.replace(/<c>|<mpaa>|<certification>/g, movie.mpaa);
        format = format.replace(/<stars>/g, movie.stars);
        format = format.replace(/<star1>/g, movie.star1);
        format = format.replace(/<stars2>/g, movie.stars2);
        format = format.replace(/<stars3>/g, movie.stars3);
        format = format.replace(/<duration>|<time>/g, movie.duration);

        
				var savedStr:String = '';
        
        var keepSavedParts:Array = [];
        
				for each(var sp:SearchPart in search_parts.getChildren()) {
					if(sp.data.state == 'keep') 
            keepSavedParts.push(sp.data.part);
				}

        savedStr = keepSavedParts.join(config.savedPartSeparator.replace('&nbsp;',' '));

        format = format.replace(/<s>|<saved>/g, savedStr);
				
 				if(ext) { // test and file is dvd folder, ext is null 
          if(format.substr(format.length - 1) != '.')
            format += '.';
          format += ext.toLowerCase();
				} else {
          // Don't let a folder name end in a period
          format = format.replace(/\.+$/,'');
        }
				format = cleanTitle(format, true);
				return format;
			}
			
			private function generateFilename(format:String, movie:Object):void {
        try {
          newFilename = parseFormat(format, movie, (fileIsDVDFolder ? null : selectedFile.extension));
        } catch (e:Error) {
          // errors when options set from folders page?
        }
			}	

			// parse imdb SINGLE MOVIE html for movie info with regular expressions
			private function reMovie(movies:ArrayCollection, html:String, type:String):void {
				var results:Array;

        // NEW: There is now JSON in the returned page that we can grab
        
        var jsonRegex:BigRegExp = new BigRegExp("<script type=\"application\\/ld\\+json\">(.*?})\\s*<\\/script>","ms");
        
        var obj:Object = {};
        
        if(config.useImdbJson) 
          results = jsonRegex.exec(html);
        
        if (results) {
          var jobj:Object = JSON.decode(results[1]);
          if(jobj) {
            obj.title = cleanTitle(htmlUnescape(StringUtil.trim(jobj.name)).replace(/\.\.\./g,'…'));

            var yearRe:RegExp = new RegExp("(\\d+)-\\d+-\\d+");
            var resultsYear:Array = yearRe.exec(jobj.datePublished);
            if(resultsYear)
              obj.year = StringUtil.trim(resultsYear[1]);
            
            var urlTt:RegExp = new RegExp("\\/title\\/(tt\\d+)\\/");
            var resultsTt:Array = urlTt.exec(jobj.url);
            if(resultsTt)
              obj.tt = StringUtil.trim(resultsTt[1]);
            
            
            obj.rating = "";
            var ratingRe:RegExp = new RegExp("(\\d+\\.\\d+)");
            var resultsRating:Array = ratingRe.exec(jobj.aggregateRating.ratingValue);
            if(resultsRating)
              obj.rating = resultsRating[1].toString().replace(/\./,'');
            
            
            obj.stars = "";
            obj.star1 = "";
            obj.stars2 = "";
            obj.stars3 = "";
            
            if(jobj.actor) {
              if (jobj.actor is Array) {
                
                var stars_names:Array = [];
                for each (var jstar:Object in jobj.actor) {
                  stars_names.push(jstar.name);
                }
                obj.stars = stars_names.join(config.starsSeparator.replace('&nbsp;',' '));

                if(jobj.actor[0] && jobj.actor[0].name) {
                  obj.star1 = obj.stars2 = obj.stars3 = htmlUnescape(StringUtil.trim(jobj.actor[0].name));
                  if(jobj.actor[1] && jobj.actor[1].name) {
                    obj.stars2 = obj.stars3 = obj.stars2 + "," + htmlUnescape(StringUtil.trim(jobj.actor[1].name));
                    if(jobj.actor[2] && jobj.actor[2].name) {
                      obj.stars3 = obj.stars3 + "," + htmlUnescape(StringUtil.trim(jobj.actor[2].name));
                    }
                  }
                }
              } else {
                if(jobj.actor.name) {
                  obj.stars = obj.star1 = obj.stars2 = obj.starts3 = htmlUnescape(StringUtil.trim(jobj.actor.name));
                }
              }
            }
            
            if(bTraceDetails) trace('Stars: ' + obj.stars);
            
            
            obj.directors = "";
            obj.director = "";
            obj.rev_directors = "";
            obj.rev_director = "";

            if(jobj.director) {
              if (jobj.director is Array) {

                var directors_names:Array = [];
                var reversed_directors_names:Array = [];
                for each (var jdirector:Object in jobj.director) {
                  directors_names.push(jdirector.name);
                  reversed_directors_names.push(reverseName(jdirector.name));
                }

                obj.directors = directors_names.join(config.directorsSeparator.replace('&nbsp;',' '));
                obj.rev_directors = reversed_directors_names.join(config.rdirectorsSeparator.replace('&nbsp;',' '));
                
                if(jobj.director[0] && jobj.director[0].name) {
                  obj.director = htmlUnescape(StringUtil.trim(jobj.director[0].name));
                  obj.rev_director = htmlUnescape(StringUtil.trim(reverseName(jobj.director[0].name)));
                }
              } else {
                if(jobj.director.name) {
                  obj.directors = obj.director = htmlUnescape(StringUtil.trim(jobj.director.name));
                  obj.rev_directors = obj.rev_director = htmlUnescape(StringUtil.trim(reverseName(jobj.director.name)));
                }
              }
            }
            
            if(bTraceDetails) trace('Director(s): ' + obj.directors);
            

            obj.genres = "";
            obj.genre = "";
            
            if(jobj.genre) {
              if (jobj.genre is Array) {
                obj.genres = jobj.genre.join(config.genresSeparator.replace('&nbsp;',' '));
                
                if(jobj.genre[0]) {
                  obj.genre = htmlUnescape(StringUtil.trim(jobj.genre[0]));
                }
              } else {
                if(jobj.genre) {
                  obj.genres = obj.genre = htmlUnescape(StringUtil.trim(jobj.genre));
                }
              }
            }
            
            if(bTraceDetails) trace('Genre(s): ' + obj.genres);
            
            
            obj.duration = "";
            if(jobj.duration) {
              var durationRe:RegExp = new RegExp("PT(\\d*)H?(\\d+)M");
              var resultsDuration:Array = durationRe.exec(jobj.duration);
              if(resultsDuration) {
                var minutes:int = 0;
                if(resultsDuration[1] && resultsDuration[1] != "") {
                  minutes = parseInt(resultsDuration[1]) * 60;
                }
                if(resultsDuration[2] && resultsDuration[2] != "") {
                  minutes += parseInt(resultsDuration[2]);
                }
              }
              obj.duration = minutes;
            }
            if(bTraceDetails) trace('Duration: ' + obj.duration);

            obj.mpaa = "";
            if(jobj.contentRating) {
              obj.mpaa = jobj.contentRating;
              for each (var conv:Array in config.mpaaConversion) {
                if(conv[0] == jobj.contentRating) {
                  obj.mpaa = conv[1];
                  break;
                }
              }
            }
            if(bTraceDetails) trace('ContentRating: ' + obj.duration);
            
          }
        }
          
        if(!obj.title || !obj.year || obj.title == "" || obj.year == "") {
          results = reTitleYear.exec(html);
          if(results) {
            if(!obj.title || obj.title == "") {
              obj.title = cleanTitle(htmlUnescape(StringUtil.trim(results[1])).replace(/\.\.\./g,'…'));
            }
            if(!obj.year || obj.year == "") {
              obj.year = StringUtil.trim(results[2]);
            }
            results = reTitleId.exec(html);
            if(results) {
              obj.tt = 'tt' + StringUtil.trim(results[1]);
            }
          } else {
            trace("Couldn't read title/year!!!");
            traceLargeString(html);
          }
        }
       
        
        if(!obj.rating || obj.rating == "") {
          results = reRating.exec(html);
          
          if(results) {
            obj.rating = results[1].toString().replace(/\./,'');
          } else {
            results = reRatingAlternate.exec(html);
            if(results)
              obj.rating = results[1].toString().replace(/\./,'');
          }
        }
        
        trace('++> Title: ' + obj.title + ' Year: ' + obj.year + ' TT: ' + obj.tt);

				// There appears to be some limit or other condition that causes BigRegExp to fail on large strings when looking for the AKA info, director, etc.
				// going line by line resolves it...for certain movies the AKA happens 45k+ into the html.				
				// var lines:Array = html.split(/\n/);
        
        if(!obj.directors || obj.directors == "") {
          obj.directors = "";
          obj.director = "";
          obj.rev_directors = "";
          obj.rev_director = "";
          results = reDirectorGroup.exec(html);
          if(results) {
            var directorIndex:int = 0;
            var directorString:String = results[1];
            do {
              results = reDirector.exec(directorString.substring(directorIndex));
              if(results) {
                var director:String = (htmlUnescape(StringUtil.trim(results[1])));
                directorIndex += (results[0].length + results.index);
                if(obj.directors != "") {
                  obj.directors += config.directorsSeparator.replace('&nbsp;',' ');
                  obj.rev_directors += config.rdirectorsSeparator.replace('&nbsp;',' ');
                }
                obj.directors += director;
                obj.rev_directors += reverseName(director);
                if(obj.director == "") {
                  obj.director = director;
                  obj.rev_director = reverseName(obj.director);
                }
                if(bTraceDetails) trace('Directors: ' + obj.directors);
              }
            } while(results);
          }
        }
        
        if(!obj.genre || obj.genre == "") {
          obj.genres = "";
          obj.genre = "";
          results = reGenreGroup.exec(html);
          if(results) {
            var genreIndex:int = 0;
            var genreString:String = results[1];
            do {
              results = reGenre.exec(genreString.substring(genreIndex));
              if(results) {
                var genre:String = (htmlUnescape(StringUtil.trim(results[1]))); 
                genreIndex += (results[0].length + results.index);
                if(obj.genres != "")
                  obj.genres += config.genresSeparator.replace('&nbsp;',' ');
                obj.genres += genre;
                if(obj.genre == "")
                  obj.genre = genre;
                if(bTraceDetails) trace('Genres: ' + obj.genre);
              }
            } while(results);
          }
        }

        if(!obj.stars || obj.stars == "") {
          obj.stars = "";
          obj.star1 = "";
          obj.stars2 = "";
          obj.stars3 = "";
          results = reStarsGroup.exec(html);
          if(results) {
            var starIndex:int = 0;
            var starCount:int = 0;
            var starsString:String = results[1];
            do {
              results = reStar.exec(starsString.substring(starIndex));
              if(results) {
                starCount += 1;
                starIndex += (results[0].length + results.index);
                
                var star:String = (htmlUnescape(StringUtil.trim(results[1])));
                
                if(obj.stars != "")
                  obj.stars += config.starsSeparator.replace('&nbsp;',' ');
                obj.stars += star;
                
                if(obj.star1 == "")
                  obj.star1 = star;
                
                if(starCount < 3) {
                  if(obj.stars2 != "") 
                    obj.stars2 += config.starsSeparator.replace('&nbsp;',' ');
                  obj.stars2 += star;
                }
                
                if(starCount < 4) {
                  if(obj.stars3 != "") 
                    obj.stars3 += config.starsSeparator.replace('&nbsp;',' ');
                  obj.stars3 += star;
                }
                
                if(bTraceDetails) trace('Stars: ' + obj.stars);
              }
            } while(results);
          }
        }

        if(!obj.duration || obj.duration == "") {
          results = reDuration.exec(html);
          if(results) {
            obj.duration = htmlUnescape(StringUtil.trim(results[1]));
          } else {
            obj.duration = "";
          }
        }
        
        if(!obj.mpaa || obj.mpaa == "") {
          obj.mpaa = config.mpaaConversion[0][1]; // ['NF','NR'] so 'NR'
          results = reMPAARating.exec(html);
          if(results) {
            obj.mpaa = results[1];
            for each (var conv:Array in config.mpaaConversion) {
              if(conv[0] == results[1]) {
                obj.mpaa = conv[1];
                break;
              }
            }
          }
        }
        
				// see if there is one AKA...new design only shows one
				obj.aka = [];

				results = reOriginalTitle.exec(html);
				if(results) {
					if(config.useOriginalTitleAsAka) {
						bAKAUsed = true;
					}
					obj.original = cleanTitle(htmlUnescape( StringUtil.trim(results[1])));
					obj.aka.push(cleanTitle(htmlUnescape(obj.title + ' *this page title*'), false, true));
					obj.title = obj.original;
					if(bTraceDetails) trace('Original Title/AKA: ' + obj.original);
				}

				results = reAkaSingle.exec(html);
				if(results) {
					obj.aka.push(htmlUnescape(StringUtil.trim(results[1])));
					if(bTraceDetails) trace('AKA: ' + obj.aka[obj.aka.length -1]);
				}
				
				obj.type = type;
				movies.addItem(new ObjectProxy(obj));					
			}

			// parse imdb SEARCH html for movie info with regular expressions
			// The main thing we are missing from the search results is the rating...
			private function reMovies(movies:ArrayCollection, html:String, type:String = ""):void {
				var results:Array;

        var index:int = 0;
        while(true) {
          var obj:Object = {};
          results = reMovieSearch.exec(html.substr(index));
          if(results) {
            index += results.index + results[0].length;
            
            obj.tt = 'tt' + StringUtil.trim(results[1]);
            obj.title = StringUtil.trim(results[2]);
            obj.year = StringUtil.trim(results[3]);
            obj.aka = [];
            obj.type = type;
            trace('==> Title: ' + obj.title + ' Year: ' + obj.year + ' TT: ' + obj.tt);
            movies.addItem(new ObjectProxy(obj));					
          } else {
            break;
          }
        }
			}
