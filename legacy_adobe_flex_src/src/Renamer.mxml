			private function onOptionsSave(e:Event):void {
				this.parentDocument.saveConfig();
				trace('Options Save Refresh'); 
				cleanUp(); 
				_zeeb.onProcess();
			} 
			
			private var undoPopup:Undo;
			private function onUndo():void {
				undoPopup = new Undo();
				undoPopup.data = data;
				PopUpManager.addPopUp(undoPopup, this, true);
			}
			
			private function writeToLog(output:String):void {
				if(logFile) {
					var fileStream:FileStream = new FileStream();
					fileStream.open(logFile, FileMode.APPEND);
					fileStream.writeMultiByte(output, File.systemCharset);
					fileStream.close();	    
				} else {
					Alert.show('The rename log file location has not been set, though this should have happened automatically. Logs are not being created', 'Non-critical Warning');
				}
			} 
			
      private var tmdbRetries:int;
      
			private function doTMDBLookup(tt:String):void {
        posters_status.visible = true;  
        posters_status.text = 'Loading posters from themoviedb.org...';
				posters  = new ArrayCollection;
				if(currentMovieInfo.hasOwnProperty('tt')) {
          
                     
          if(doTMDBConfigLookupAsNeeded(tt)) return;
          
          tmdbRetries = 0;
//					tmdbImagesTT.url="http://api.themoviedb.org/2.1/Movie.getImages/en/xml/bb81778a56280ab7f28d2048dfdbec88/" + currentMovieInfo.tt
					tmdbImagesTT.url="http://api.themoviedb.org/3/movie/" + currentMovieInfo.tt + "/images?api_key=" + tmdbApiKey;
          trace(tmdbImagesTT.url);  
					fetchURL(tmdbImagesTT);
				}
			}
			
      private function doTMDBConfigLookupAsNeeded(tt:String):Boolean {
        if(!tmdbLastConfigUpdate || tmdbLastConfigUpdate + 21600 > new Date()) { //21600 = 6 hrs
          tmdbConfig.url = 'http://api.themoviedb.org/3/configuration?api_key=' + tmdbApiKey;
          fetchURL(tmdbConfig);
          tmdbAfterConfigTT = tt;
          return true;
        }
        return false;
      }

      private function tmdbConfigResult(e:ResultEvent):void {
        trace(new Date().toTimeString() + " <- fetchURL: " + e.currentTarget.url);
        tmdbLastConfigUpdate = new Date();
        tmdbParsedConfig = JSON.decode(tmdbConfig.lastResult as String);
        doTMDBLookup(tmdbAfterConfigTT);
      }
      
			private function tmdbImagesResult(e:ResultEvent):void {
        trace(new Date().toTimeString() + " <- fetchURL: " + e.currentTarget.url);
        posters_status.visible = false;  
        
        var decoded:Object = JSON.decode(tmdbImagesTT.lastResult as String);
        
				if(!decoded.posters) {
					posters = new ArrayCollection();
          posters_status.text = 'Movie not found on themoviedb.org';
          posters_status.visible = true;
				} else if(!(decoded.posters is Array)) {
          posters = new ArrayCollection();
          posters_status.text = 'No posters found on themoviedb.org';
          posters_status.visible = true;
        } else {
					try {
						posters = new ArrayCollection(ArrayUtil.toArray(decoded.posters));
					} catch(e:Error) {
						posters = null;
            posters_status.text = 'Error processing posters on themoviedb.org';
            posters_status.visible = true;
					}
				}
			}
			
			private function onPosterData(e:Event):void {
				var i:Image = e.currentTarget as Image;
				if(i.data[0]) {
  				var size:String = browser_enabled.selected ? 'w92' : 'w185';
          i.width = browser_enabled.selected ? 92 : 185;
          i.source = tmdbParsedConfig.images.base_url + size + i.data[0].file_path;
          trace(i.source);
        }
				if(i.data[1] == 0) {
				  callLater(function(target:Image):void {
					  onPosterClickProcess(target);
				  }, [i]);
				}
			}

			private function onPosterClick(e:Event):void {
				onPosterClickProcess(e.currentTarget as Image);		
			}
		
			private var original_poster:Image;
			private var poster_loading:Boolean = false;
			private function onPosterClickProcess(i:Image):void {
        
        if(i.parent == null) {
          callLater(function(target:Image):void {
            onPosterClickProcess(target);
          }, [i]);
          return;
        }
        
				if(original_poster) {
					try {
						original_poster.removeEventListener(Event.COMPLETE, onPosterLoaded);	
					} catch(e:Error) {};
					original_poster = null;
				}
				
				var c:Container; 
				for each(c in posters_box.getChildren()) {
					c.setStyle('borderColor','#FFFFFF');
				}
        try { 
          (i.parent.parent as Container).setStyle('borderColor','#000000');
        } catch(e:Error) {
          trace(e.message);
        }
        
				original_poster = new Image();
				original_poster.initialize();
        original_poster.load(tmdbParsedConfig.images.base_url + 'w500' + i.data[0].file_path);
				original_poster.addEventListener(Event.COMPLETE, onPosterLoaded);
				poster_loading = true;
			}
			
			private function onPosterLoaded(e:Event):void {
				try {
					original_poster.removeEventListener(Event.COMPLETE, onPosterLoaded);	
				} catch(e:Error) {};
				poster_loading = false;
			}
			
			private function onPosterOnly():void {
				onFinalRename(true);				
			}
			
			private function onTMDBFault(e:FaultEvent):void {
        if(e.statusCode == 404) {
          posters_status.visible = true;
          posters_status.text = "No posters found on themoviedb.org";
        } else if(e.statusCode == 503) {
         if(tmdbRetries < 5) { 
           tmdbRetries +=1;
           posters_status.visible = true;
           posters_status.text = "Retry #" + tmdbRetries + ". Loading movies from themoviedb.org...";
           trace(e.message.toString());
           fetchURL(tmdbImagesTT);
           return;
         }
         Alert.show("Unable to retrieve poster from themoviedb.org after " + tmdbRetries.toString() + " attempts. It appears their API is down, which seems to happen occasionally. We recommend trying again later when the API is functioning properly if you see this message more than once.");
        } else {
          Alert.show("Unable to retrieve poster from themoviedb.org. Status code returned was :" + e.statusCode + ".");
        }
			}

			private function createPosterTip(event:ToolTipEvent):void {
				ToolTipManager.hideDelay = 20000;
				ToolTipManager.showDelay = 200;
				ToolTipManager.showDelay = 50;
				var pt:PosterTooltip = new PosterTooltip();
        var image:Object = event.currentTarget.data[0];
        pt.source = tmdbParsedConfig.images.base_url + 'w500' + image.file_path;
				event.toolTip = pt;
			}
			
      private function playMovie():void {
        selectedFile.openWithDefaultApplication();       
      }

      private function exploreMovie():void {
        selectedFile.parent.openWithDefaultApplication();       
      }
      
      private function useHtmlURL():void {
        doImdbLookup(html_box.location);
      }
      
      private function fetchURL(http:HTTPService):void {
        trace(new Date().toTimeString() + " -> fetchURL:" + http.url);
        http.send();
      }
      
      private function loadURLLoader(ul:*, url:URLRequest):void {
        trace(new Date().toTimeString() + " -> loadURLLoader:" + url.url);
        ul.load(url);
      }
      

		]]>
	</mx:Script>

