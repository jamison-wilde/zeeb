			private function generateNewRelativeFile(origFile:File, newName:String, newExtension:String = ""):File {
				var newFile:File = new File();
				newFile = origFile.resolvePath('..');
				newFile = newFile.resolvePath(newFile.nativePath + "/" + newName);
				if(newExtension != "" && newExtension != null) {
					newFile.nativePath = newFile.nativePath.substr(0, newFile.nativePath.length - newFile.extension.length) + '.' + newExtension;
				}
				return newFile;
			}

			private function checkFileExists(newFile:File, origFile:File = null):Boolean {
				if(newFile.exists) {
					if(origFile != null && newFile.nativePath == origFile.nativePath) {
						// just don't do anything if we are trying to rename to the same thing
            return true;
					}	else {
						Alert.show("The filename you are trying to use already exists!\n" + newFile.nativePath);
						return true; 
					}		
				}
				return false;
			}
			
			private function moveFile(origFile:File, newFile:File):Boolean {
				try {
					var n:String = origFile.nativePath;
					origFile.moveTo(newFile, false);
					_zeeb.addUndoAction(['rename', newFile.nativePath, origFile.nativePath]);
					log += "\nRename " + n + " to " +  newFile.nativePath;
					return true;
				} catch(e:Error) {
					Alert.show("Couldn't rename the file. It could be open by another process (like a video player or copy process) or you don't have permissions.");
					_zeeb.commitUndoTransaction();
				}
				return false;
			}
			
			private function createURLFile(movieFile:File):Boolean {
				var oldURLFileData:String = removeExistingURLFile(movieFile);
				var urlFile:File = new File(movieFile.nativePath);
				
				if(fileIsDVDFolder) {
					urlFile = new File(movieFile.nativePath + 
						(config.posterInDVDFolder ? '/' : '/../') + 
						(config.separateURLFormat ? parseFormat(config.renameFormatURL, currentMovieInfo, 'url') : movieFile.name + '.url' ));
				} else {
					if(config.separateURLFormat)
						urlFile = new File(movieFile.nativePath + '/../' + parseFormat(config.renameFormatURL, currentMovieInfo, 'url'));
					else 
						urlFile = new File(movieFile.nativePath.substr(0, movieFile.nativePath.length - movieFile.extension.length) + 'url');
				}
				
				if(movieFile.nativePath != urlFile.nativePath && urlFile.extension.toLowerCase() == 'url') { // never overwrite the original file!
					var fs:FileStream = new FileStream();
					try {
						fs.open(urlFile, FileMode.WRITE);
						fs.writeMultiByte("[InternetShortcut]\nURL=" + config.urlImdbTT + currentMovieInfo.tt + "\n", File.systemCharset);  // trailing \n is important for Safari
						if(config.includeOriginalMovieFilenameinURLFile)  
							fs.writeMultiByte("\n[OriginalFilename]\nNAME=" + selectedFile.nativePath + "\n", File.systemCharset);  // trailing \n is important for Safari

            try {
              if(config.includeNFOinURLFile && selectedNFOFile != null && selectedNFOFile.exists && selectedNFOFile.size < 200 * 1024) {
                fs.writeMultiByte("\n[NFO]\n", File.systemCharset);
                try {
                  
                  var nfoLines:String = "NFO=" + readNFO(selectedNFOFile).split(/\r*\n+/m).join("\nNFO=");
                  
                  fs.writeMultiByte(nfoLines, File.systemCharset);
                } catch(e:Error) {
                  Alert.show("Unable to read NFO file to include in .url file.\n" + selectedNFOFile.nativePath + "\n" +e.message);
                  return false;
                };
                
                fs.writeMultiByte("\n", File.systemCharset);
                
                if(config.deleteOriginalNFO) {
                  try {
                    selectedNFOFile.deleteFile();
                  } catch(e:Error) {
                    trace(e.message);  
                  }
                }
              }
            } catch(e:Error) {
              Alert.show("Unable to read NFO file to include in .url file.\n" + selectedNFOFile.nativePath + "\n" + e.message);
            }

            if(oldURLFileData && oldURLFileData != "") {
							fs.writeMultiByte(oldURLFileData + "\n", File.systemCharset);
						}
						
						fs.close();
						
						_zeeb.addUndoAction(['delete', urlFile.nativePath]);
					} catch(e:Error) {
						Alert.show("Unable to write .url file. The disk may be full or there is some other issue.\n" + urlFile.nativePath + "\n" +e.message);
						return false;
					}
				} else {
					Alert.show("WARNING! URL file not created! Was the same name as the movie file or the extension was missing!\n" + urlFile.nativePath );
					return false;
				}
				return true;
			}
			
			private function addIfExists(t:File, a:Array, extension:String = null):void {
				if(t.exists && (!extension || t.extension == extension)) {
          // if we are renaming to the same thing there can be dupes...
          for each(var b:File in a) {
            if(b.nativePath == t.nativePath) 
              return;
          }
          a.push(new File(t.nativePath)); 
        }
			}
			
			private function findExistingFiles(files:Array, _extension:Object, format:String = null):Array {
				var testFiles:Array = [];
				var t:File;
        var ext:String;
				var formatted:String;
        if(format)
          formatted = parseFormat(format, currentMovieInfo);
				var finalFiles:Array = [];

        var extensions:Array;
        if(_extension is Array)
          extensions = (_extension as Array);
        else
          extensions = [_extension];
        
				for each(var f:File in files) {
					if(f.isDirectory || (!f.exists && f.extension == null)) {
						// no extension!
						if(format) {
              for each (ext in extensions) {
                testFiles.push(f.nativePath + '/' + formatted + '.' + ext);
                testFiles.push(f.nativePath + '/../' + formatted + '.' + ext);
              }
						} 
            for each (ext in extensions) {
  						testFiles.push(f.nativePath + '.' + ext);
  						testFiles.push(f.nativePath + '/' + f.name + '.' + ext);
            }
					} else {
						// extension!
						if(format) {
              for each (ext in extensions) {
  							testFiles.push(f.nativePath.substr(0, f.nativePath.length - f.name.length) + formatted + '.' + ext);
              }
						} 
            for each (ext in extensions) {
  						testFiles.push(f.nativePath.substr(0, f.nativePath.length - f.extension.length) + ext);
            }
					}
				}
					
				if(testFiles.length > 0) {
					for each(var s:String in testFiles) {
						t = new File(s);
						addIfExists(t, finalFiles);
					}
				}
				return finalFiles;
			}
			
  		private function removeExistingURLFile(movieFile:File):String {
				var result:String = "";

				// find the original .url file...it may have been moved if the movie is a directory 
				
				var urlFiles:Array = findExistingFiles([movieFile, selectedFile], 'url', (config.separateURLFormat ? config.renameFormatURL : null));
				if(urlFiles.length > 0) {
          
          for each (var f:File in urlFiles) {
            var d:Object = processExistingURLFile(f);

            for (var key:String in d) {
              switch(key) {
                case 'InternetShortcut':
                case 'OldInternetShortcut':
                  result += '\n[OldInternetShortcut]\n' + d[key];
                  break;
                 case 'OriginalFilename':
                   if(config.includeOriginalMovieFilenameinURLFile)
                    result += '\n[' + key + ']\n' + d[key];
                   break;
                 case 'NFO':
                   if(config.includeNFOinURLFile)
                     result += '\n[' + key + ']\n' + d[key];
                   break;
                 default:
                   result += '\n[' + key + ']\n' + d[key];
                   break;
              }
            }
           
            try {
              var n:String = f.nativePath;
              f.deleteFile();
              log += "\nDelete " + n;
            } catch(e:Error) {
              trace(e.message);
            }
          }
				}
				
				return result;
			}
      
      private function moveAndRenameSubtitleFiles(movieFile:Object):void {
        // rename the existing subtitle files 
        var subTitleFiles:Array = findExistingFiles([movieFile, selectedFile], config.subtitle_extensions);
        for each(var subtitleFile:File in subTitleFiles) {
          
          var newSubtitleFile:File = subtitleFile.resolvePath('..');
          newSubtitleFile.nativePath += "/" + escaped_name;
          newSubtitleFile.nativePath = newSubtitleFile.nativePath.substr(0, newSubtitleFile.nativePath.length - newSubtitleFile.extension.length) + subtitleFile.extension;
          
          if(newSubtitleFile.exists) {
            if(newSubtitleFile.nativePath == subtitleFile.nativePath) {
              // just don't do anything is we are trying to rename to the same thing						
            }	else {
              Alert.show("Couldn't rename a subtitle file because it already exists: " + newSubtitleFile.nativePath );
            }		
          } else {
            try {
              var n:String = subtitleFile.name;
              subtitleFile.moveTo(newSubtitleFile, false);
              _zeeb.addUndoAction(['rename', newSubtitleFile.nativePath, subtitleFile.nativePath]);
              log += "\nRename Subtitle " + n + " to " +  newSubtitleFile.name;
            } catch(e:Error) {
              Alert.show("Couldn't rename a subtitle file: " + subtitleFile.nativePath + ". It could be open by another process (like a video player or copy process) or you don't have permissions.");
            }
          }
        } 
      }
      
      private function processExistingURLFile(file:File):Object {
        var r:Object = {};
        
        var fileStream:FileStream = new FileStream();
        fileStream.open(file, FileMode.READ);
        var lines:Array = fileStream.readMultiByte(file.size, File.systemCharset).split(/\r*\n+/m); // For some reason Flex converts \n to \r?
        fileStream.close();
        
        var nextSection:Object;
        while(nextSection = getNextURLFileStringSection(lines)) {
          if(!r.hasOwnProperty(nextSection.key)) {
            r[nextSection.key] = [];
          }
          (r[nextSection.key] as Array).push(nextSection.data);
        }
        
        return r;
      }
      
      
      private var reURLFileSection:RegExp = /^\[(.*)\]$/;
      
      private function getNextURLFileStringSection(lines:Array):Object {
        var r:Object = {};
        var match:Array;
        
        var line:String;
        while((line = lines.shift()) != null) {
          if((match = reURLFileSection.exec(line)) != null) {
            r.key = match[1];
            r.data = "";
            while((line = lines.shift()) != null) {
              if((match = reURLFileSection.exec(line)) != null) {
                lines.unshift(line);
                break;
              }
              if(line != "" && line != " ") 
                r.data = r.data + line + "\n";
            }
            return r;
          }
        }
        return null;
      }
			
