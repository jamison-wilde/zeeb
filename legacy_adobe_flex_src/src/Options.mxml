          <mx:Text text="MPAA/Certification&#13;{tooltipConfig.reMPAARating}" selectable="true"/>
          <mx:TextInput text="{config.reMPAARating}" change="config.reMPAARating = (event.currentTarget as TextInput).text"/>
          
          <mx:Text text="Stars Group&#13;{tooltipConfig.reStarsGroup}" selectable="true"/>
          <mx:TextInput text="{config.reStarsGroup}" change="config.reStarsGroup = (event.currentTarget as TextInput).text"/>

          <mx:Text text="Stars Each&#13;{tooltipConfig.reStar}" selectable="true"/>
          <mx:TextInput text="{config.reStar}" change="config.reStar = (event.currentTarget as TextInput).text"/>

          <mx:Text text="Duration/Time&#13;{tooltipConfig.reDuration}" selectable="true"/>
          <mx:TextInput text="{config.reDuration}" change="config.reDuration = (event.currentTarget as TextInput).text"/>
          
          <mx:Text text="Full AKA Group&#13;{tooltipConfig.reAkaMoreGroup}" selectable="true"/>
          <mx:TextInput text="{config.reAkaMoreGroup}" change="config.reAkaMoreGroup = (event.currentTarget as TextInput).text"/>
          
          <mx:Text text="Full AKA Each&#13;{tooltipConfig.reAkaMore}" selectable="true"/>
          <mx:TextInput text="{config.reAkaMore}" change="config.reAkaMore = (event.currentTarget as TextInput).text"/>

        </mx:VBox>
        
        <mx:VRule height="100%"/>
        
        <mx:VBox width="400">
          <mx:Label text="Test Movie" fontSize="18" fontWeight="bold"/>
          <mx:Label text="TT Movie Id ({tooltipConfig.testMovieId})" selectable="true"/>
          <mx:HBox horizontalGap="-2">
            <mx:Label text="tt"/>
            <mx:TextInput id="tt" text="{config.testMovieId}" change="config.testMovieId = (event.currentTarget as TextInput).text"/>
            <mx:Spacer width="10"/>
            <mx:Button styleName="btn" label="Test Movie" click="testRegularExpressions(true);"/>
          </mx:HBox>
          
          <mx:Text width="100%" text="IMDB TT:&#13;{renamer.parseFormat('&lt;tt&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Title:&#13;{renamer.parseFormat('&lt;t&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Initial AKA:&#13;{renamer.parseFormat('&lt;a&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Rating(100):&#13;{renamer.parseFormat('&lt;r100&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Rating(10.0):&#13;{renamer.parseFormat('&lt;r10&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Year:&#13;{renamer.parseFormat('&lt;y&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Directors List:&#13;{renamer.parseFormat('&lt;d&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Director (First):&#13;{renamer.parseFormat('&lt;d1&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Genre List:&#13;{renamer.parseFormat('&lt;g&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Genre (First):&#13;{renamer.parseFormat('&lt;g1&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="MPAA/Certification:&#13;{renamer.parseFormat('&lt;c&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Stars:&#13;{renamer.parseFormat('&lt;stars&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Star1:&#13;{renamer.parseFormat('&lt;star1&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Stars2:&#13;{renamer.parseFormat('&lt;stars2&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Stars3:&#13;{renamer.parseFormat('&lt;stars3&gt;', renamer.currentMovieInfo)}"/>
          <mx:Text width="100%" text="Duration/Time:&#13;{renamer.parseFormat('&lt;duration&gt;', renamer.currentMovieInfo)}"/>
          
        </mx:VBox>
        
      </mx:HBox>
      
      <mx:HRule width="100%"/>
      
      <mx:HBox width="100%">
        
        <mx:VBox width="100%">
          <mx:Label text="Search Results" fontSize="18" fontWeight="bold"/>
          
          <mx:Label text="No Results ({tooltipConfig.reFindNoResults})" selectable="true"/>
          <mx:TextInput text="{config.reFindNoResults}" change="config.reFindNoResults = (event.currentTarget as TextInput).text"/>
          
          <mx:Label text="Title Begin ({tooltipConfig.reTitle})" selectable="true"/>
          <mx:TextInput text="{config.reTitle}" change="config.reTitle = (event.currentTarget as TextInput).text"/>
          
          <mx:Label text="Movie Each ({tooltipConfig.reMovieSearch})" selectable="true"/>
          <mx:TextInput text="{config.reMovieSearch}" change="config.reMovieSearch = (event.currentTarget as TextInput).text"/>
          
        </mx:VBox>
        
        <mx:VRule height="100%"/>
        
        <mx:VBox width="400">
          <mx:Label text="Test Search" fontSize="18" fontWeight="bold"/>
          <mx:Label text="Movie Filename ({tooltipConfig.testMovieFileName})" selectable="true"/>
          <mx:HBox>
            <mx:TextInput id="search" text="{config.testMovieFileName}" change="config.testMovieFileName = (event.currentTarget as TextInput).text"/>
            <mx:Button styleName="btn" label="Test Search" click="testRegularExpressions(false);"/>
          </mx:HBox>

          <mx:TileList id="movie_tiles" dataProvider="{renamer.movies}" width="385" backgroundAlpha="0" fontSize="12" height="400" selectionColor="0xaaaaaa" rollOverColor="0xF8F8F8" direction="horizontal" horizontalScrollPolicy="off" verticalScrollPolicy="auto" columnWidth="380" rowHeight="45" borderStyle="none">
            <mx:itemRenderer>
              <mx:Component>
                <mx:VBox verticalScrollPolicy="off" borderStyle="solid" borderThickness="1" borderColor="#999999" height="45" width="480" verticalGap="0" horizontalScrollPolicy="off">
                  <mx:Label htmlText="{data.title} ({data.year}) &lt;font color='#666666'&gt;{data.type}&lt;/font&gt;" width="100%" paddingTop="1" fontSize="13"/>
                  <mx:Label htmlText=" aka: {data.aka}" visible="{data.aka != ''}" includeInLayout="{data.aka != ''}" width="100%" paddingTop="-7" fontSize="9" color="#666666" toolTip="{data.aka}"/>
                </mx:VBox>
              </mx:Component>
            </mx:itemRenderer>
          </mx:TileList>
          
        </mx:VBox>
        
      </mx:HBox>
      
      
      <mx:HRule width="100%"/>
      <mx:Label text="Other Regular Expression Settings" fontSize="18" fontWeight="bold"/>
      
      <mx:Label text="Filename Parts Delimiters ({tooltipConfig.reFilenamePartsSplitter})" selectable="true"/>
      <mx:TextInput text="{config.reFilenamePartsSplitter}" change="config.reFilenamePartsSplitter = (event.currentTarget as TextInput).text"/>
      
      <mx:HRule width="100%"/>
      
      <mx:Label text="Non-Regular Expression Settings" fontSize="18" fontWeight="bold"/>
      
      <mx:Label text="See More AKA URL Path ({tooltipConfig.strSeeMoreAka})" selectable="true"/>
      <mx:HBox>
        <mx:Label text="http://www.imdb.com/title/tt{tt.text}"/>
        <mx:TextInput text="{config.strSeeMoreAka}" change="config.strSeeMoreAka = (event.currentTarget as TextInput).text"/>
      </mx:HBox>
      
    </mx:VBox>
	</mx:TabNavigator>
  
