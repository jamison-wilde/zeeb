<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml" layout="vertical" 
								title="Options"
								creationComplete="onComp()"
								modalTransparencyBlur="0.3"
								modalTransparencyColor="#FFFFFF"
								borderAlpha="0.9" 
								showCloseButton="true"
								close="onClose()"
								fontFamily="Lucida Sans Unicode"
								fontWeight="normal"
								width="1150"
                height="700"
								dataChange="onData()"
>
	
	<mx:Script>
		<![CDATA[
      import com.slaingod.config.Config;
      
      import mx.collections.ArrayCollection;
      import mx.managers.PopUpManager;
			
			[Bindable]
			public var config:Config;

      [Bindable]
      public var renamer:Renamer;

      [Bindable]
      private var tooltipConfig:Config = new Config;
			
			private function onComp():void {
				PopUpManager.centerPopUp(this);
			}

			private function onData():void {
//				config = data as Config;	
			}
			
			private function onNfoBrowse():void {
        var file:File = new File();
				file.addEventListener(Event.SELECT, nfoDirSelected);
				file.browseForDirectory("Select directory containing NFOs");
			}

      private function onLogfileBrowse():void {
        var file:File = new File();
        if(logfile_location.text && logfile_location.text != "") {
          try {
            file.resolvePath(logfile_location.text);
          } catch (e:Error) {
            file.resolvePath(File.applicationStorageDirectory.nativePath);            
          }
        }
        file.addEventListener(Event.SELECT, logfileDirSelected);
        file.browseForDirectory("Select directory to store logfile");
      }

			private function nfoDirSelected(e:Event):void {
				nfo_folder.text = (e.target as File).nativePath;
				config.nfoFolder = (e.target as File).nativePath; 
			} 

      private function logfileDirSelected(e:Event):void {
        var file:File = new File();
        var name:String;
        try {
          name = file.resolvePath(logfile_location.text).name;
        } catch(e:Error) {
        } 
        if(!name || name == "")
          name = "zeeb.log";
        
        logfile_location.text = ((e.target as File).nativePath + '/' + name).replace("\\","/");
        config.logfileLocation = logfile_location.text; 
      } 

			private function onClose():void {
				dispatchEvent(new Event('SAVE_OPTIONS')); 
				PopUpManager.removePopUp(this);				
			}

      private var html:String = "";
      
      [Bindable]
      private var movie:Object;
      
      private function testRegularExpressions(isMovie:Boolean):void {
        renamer.initBigRegExps(true);
        renamer.cleanUp(true);
        if(isMovie) {
          renamer.doImdbSingle({tt: 'tt' + tt.text});
        } else {
          renamer.parseFileName(search.text);
          renamer.doImdbLookup();
        }
      }
      
      protected function on_clickRemoveExtension(e:MouseEvent):void
      {
        if(movie_extensions.selectedIndex) {
          var ac:ArrayCollection = new ArrayCollection(config.movie_extensions);
          ac.removeItemAt(movie_extensions.selectedIndex);
          config.movie_extensions = ac.toArray();
        }
      }

      protected function on_clickAddExtension(e:MouseEvent):void
      {
        var t:String = add_extension.text;
        if(t != "" && config.movie_extensions.indexOf(t) == -1) {
          config.movie_extensions.push(t);
          movie_extensions.dataProvider = null;
          movie_extensions.dataProvider = config.movie_extensions;
          movie_extensions.scrollToIndex(config.movie_extensions.length -1);
        }
      }

    ]]>
	</mx:Script>
	
	<mx:TabNavigator height="100%" width="100%" fontWeight="normal">
