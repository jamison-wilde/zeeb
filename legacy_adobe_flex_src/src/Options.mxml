    <mx:VBox label="Advanced" width="100%" height="100%" horizontalScrollPolicy="off">
      <mx:Text width="100%" htmlText="You may directly edit the Regular Expressions used by Zeeb to scrape IMDB here.&lt;p&gt;This may enable you to adapt Zeeb to a different language version&lt;p&gt;of IMDB for instance, or fix a problem when IMDB's&lt;p&gt; site design is tweaked. Feel free to post any improvements&lt;p&gt;or non-English queries on the forum at&lt;p&gt;&lt;u&gt;&lt;a href='http://sourceforge.net/projects/zeeb/forums/forum/1064112'&gt;http://sourceforge.net/projects/zeeb/forums/forum/1064112&lt;/a&gt;&lt;/u&gt;."/>
      <mx:Text width="100%" htmlText="NOTE: DISABLE USE IMDB JSON IF YOU WANT TO ENSURE YOU ARE USING THESE REGULAR EXPRESSIONS"/>
      
      <mx:HRule width="100%"/>
      
